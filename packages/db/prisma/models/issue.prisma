model Issue {
    id          String        @id @default(uuid())
    number      Int
    title       String
    description Json?
    priority    IssuePriority @default(NO_PRIORITY)

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    creatorId String
    creator   User   @relation("IssueCreator", fields: [creatorId], references: [id])

    assigneeId String?
    assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id])

    stateId String
    state   WorkflowState @relation(fields: [stateId], references: [id])

    parentId  String?
    parent    Issue?  @relation("IssueParent", fields: [parentId], references: [id])
    subIssues Issue[] @relation("IssueParent")

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    cycleId String?
    cycle   Cycle?  @relation(fields: [cycleId], references: [id])

    labels   IssueLabelOnIssue[]
    comments IssueComment[]
    history  IssueHistory[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([teamId, number])
    @@index([teamId])
    @@index([creatorId])
    @@index([assigneeId])
    @@index([stateId])
    @@index([projectId])
    @@index([cycleId])
    @@map("issue")
}

model IssueComment {
    id   String @id @default(uuid())
    body String

    issueId String
    issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([issueId])
    @@index([userId])
    @@map("issue_comment")
}

model IssueLabel {
    id          String  @id @default(uuid())
    name        String
    color       String
    description String?

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    issues IssueLabelOnIssue[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([teamId, name])
    @@map("issue_label")
}

model IssueLabelOnIssue {
    issueId String
    issue   Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)

    labelId String
    label   IssueLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

    // Denormalized team scope so Electric shapes can filter by team without a join.
    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@id([issueId, labelId])
    @@index([teamId])
    @@index([issueId])
    @@index([labelId])
    @@map("issue_label_on_issue")
}

model IssueHistory {
    id      String @id @default(uuid())
    issueId String
    issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

    actorId String
    actor   User   @relation(fields: [actorId], references: [id])

    field    String // The field that changed (e.g., "status", "assignee", "title")
    oldValue String?
    newValue String?

    createdAt DateTime @default(now())

    @@index([issueId])
    @@map("issue_history")
}
