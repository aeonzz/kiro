model Issue {
    id          String        @id @default(uuid())
    number      Int
    title       String
    description Json?
    priority    IssuePriority @default(NO_PRIORITY)

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    creatorId String
    creator   User   @relation("IssueCreator", fields: [creatorId], references: [id])

    assigneeId String?
    assignee   User?   @relation("IssueAssignee", fields: [assigneeId], references: [id])

    stateId String
    state   WorkflowState @relation(fields: [stateId], references: [id])

    parentId  String?
    parent    Issue?  @relation("IssueParent", fields: [parentId], references: [id])
    subIssues Issue[] @relation("IssueParent")

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    cycleId String?
    cycle   Cycle?  @relation(fields: [cycleId], references: [id])

    labels            IssueLabelLink[]
    comments          IssueComment[]
    history           IssueHistory[]
    commentReactions  IssueCommentReaction[]

    position  Float?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([teamId, number])
    @@index([teamId])
    @@index([creatorId])
    @@index([assigneeId])
    @@index([stateId])
    @@index([projectId])
    @@index([cycleId])
    @@map("issue")
}

model IssueComment {
    id   String @id @default(uuid())
    body String

    issueId String
    issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    parentId String?
    parent   IssueComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies  IssueComment[] @relation("CommentReplies")

    // Any comment (root or reply) can be independently marked resolved —
    // resolving the root resolves the whole thread; resolving a reply marks
    // it as the thread's resolution/answer without resolving the others.
    resolvedAt   DateTime?
    resolvedById String?
    resolvedBy   User?   @relation("CommentResolvedBy", fields: [resolvedById], references: [id])

    reactions IssueCommentReaction[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([issueId])
    @@index([userId])
    @@index([parentId])
    @@map("issue_comment")
}

model IssueCommentReaction {
    id    String @id @default(uuid())
    emoji String

    commentId String
    comment   IssueComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

    // Denormalized from the comment so sync rules can filter this table by
    // issueId directly, matching every other issue-scoped table, instead of
    // needing a join through issue_comment.
    issueId String
    issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    // A user can react to a comment with a given emoji at most once.
    @@unique([commentId, userId, emoji])
    @@index([commentId])
    @@index([issueId])
    @@map("issue_comment_reaction")
}

model IssueLabel {
    id          String  @id @default(uuid())
    name        String
    color       String
    description String?

    teamId String
    team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

    issues IssueLabelLink[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([teamId, name])
    @@map("issue_label")
}

model IssueLabelLink {
    id String @id @default(uuid())

    issueId String
    issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

    labelId String
    label   IssueLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@unique([issueId, labelId])
    @@index([issueId])
    @@index([labelId])
    @@map("issue_label_link")
}

model IssueHistory {
    id      String @id @default(uuid())
    issueId String
    issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)

    actorId String
    actor   User   @relation(fields: [actorId], references: [id])

    field    String // The field that changed (e.g., "status", "assignee", "title")
    oldValue String?
    newValue String?

    createdAt DateTime @default(now())

    @@index([issueId])
    @@map("issue_history")
}
